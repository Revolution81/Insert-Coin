[Unit]
Description=Insert Coin QR scanner (camera + zbar, sandboxed)
Before=czwallet.service

[Service]
User=czscan
Group=czscan
WorkingDirectory=/opt/czwallet
EnvironmentFile=/etc/czwallet/signer.env
Environment=CZ_SCAN_SOCK=/run/czscan/scan.sock PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/czwallet-venv/bin/python -m core.scand
RuntimeDirectory=czscan
RuntimeDirectoryMode=0750
UMask=0007
Restart=always

# It reads camera pixels with zbar and libcamera, so assume it can be
# exploited by a crafted QR. It gets the camera and nothing else:
# no network at all (an empty network namespace), no wallet or signer
# files, no screen, no keyboard, no I2C/UART add-ons.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
DeviceAllow=char-dma_heap rw
DeviceAllow=/dev/dma_heap rw
SupplementaryGroups=video
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/var/lib/czwallet /etc/czwallet/release_keys.txt
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @module @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
# To try on the device: MemoryDenyWriteExecute=yes (may break libcamera/ctypes)

[Install]
WantedBy=multi-user.target
