# Unit NFC (ST25R3916, I2C 0x50) on its own software I2C bus, /dev/i2c-3
# (dtoverlay i2c-gpio on GPIO23/GPIO26, EXT header pins 3 and 1; see
# deploy/install.sh --nfc-unit). Only the wallet app may open it. The app
# never gets /dev/i2c-1: that bus carries the keyboard controller.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-3", GROUP="czapp", MODE="0660"
