#!/bin/sh
# Insert Coin: a clean shutdown when the power switch goes off.
#
# The Cardputer Zero's power switch is read by the M5IOE1 I/O expander
# (I2C1, 0x4F). When it goes off the chip keeps the power on for OFF_TIME
# (register 0xB2/0xB3, ms; 2 s after every power-on) and then cuts it, with
# no word to Linux. On M5Stack's OS their launcher handles this; the wallet
# image switches that off, so here: OFF_TIME is set to 7 s, the switch
# bit (0xB9 bit 0) is read every half second, and when it reads off: the
# card is synced at once, the wallet and signer stop (keys locked), a
# SHUTTING DOWN screen shows (ui/goodbye.py), and Linux
# shuts down properly (services get 4 s each, not 90) before the power goes.
#
# Careful on purpose: nothing is done unless the chip answers with its ID
# (REV 0x02 = 0x5A); it only acts after first seeing the switch ON, and only
# on three OFF readings in a row, so a misread can never shut down a device
# that's switched on.
BUS=1 ADDR=0x4f
get() { i2cget -f -y $BUS $ADDR "$1" 2>/dev/null; }

# Battery: Linux has the fuel gauge (I2C1, 0x55) as a "bq27210", but it's a
# BQ27220, so /sys/class/power_supply reads the wrong registers and its
# percentage is nonsense. Every 2 s the BQ27220's own standard commands are
# read (StateOfCharge 0x2C, Voltage 0x08, Current 0x0C, BatteryStatus 0x0A;
# reads only) into /run/czwallet-battery for the wallet (core/power.py).
battery() {
  while :; do
    soc=$(i2cget -f -y $BUS 0x55 0x2c w 2>/dev/null)
    mv=$(i2cget -f -y $BUS 0x55 0x08 w 2>/dev/null)
    ma=$(i2cget -f -y $BUS 0x55 0x0c w 2>/dev/null)
    st=$(i2cget -f -y $BUS 0x55 0x0a w 2>/dev/null)
    if [ -n "$soc" ] && [ -n "$mv" ] && [ -n "$ma" ]; then
      soc=$((soc)) mv=$((mv)) ma=$((ma)) st=$((${st:-0}))
      [ $ma -gt 32767 ] && ma=$((ma - 65536))
      if [ $soc -le 100 ] && [ $mv -gt 2500 ] && [ $mv -lt 4600 ]; then
        echo "$soc $mv $ma $st" > /run/czwallet-battery.new && mv /run/czwallet-battery.new /run/czwallet-battery
      fi
    fi
    sleep 2
  done
}
battery &

i=0
until [ "$(get 0x02)" = 0x5a ]; do
  i=$((i + 1)); [ $i -ge 30 ] && { echo "power switch: chip not found, not watching"; exec sleep infinity; }
  sleep 1
done

# OFF_TIME = 7000 ms (0x1B58), both bytes in one write as the chip expects.
# Linux needs about 2 s here (the card is synced and the wallet stopped
# first), so 7 s leaves room without a long wait on a finished screen.
OFF_MS=7000
i2ctransfer -f -y $BUS w3@$ADDR 0xb2 0x58 0x1b 2>/dev/null \
  && echo "power switch: 7 s to shut down after switching off"

# The screen's light: brightness 0 leaves it lit, so screen sleep also uses
# its real on/off switch, line 9 of the M5IOE1's GPIO chip (as M5Stack's
# launcher does). The signer (which may not touch GPIO) asks by creating
# /run/czwallet/screen-off; this loop switches the light to match.
light() {
  /usr/local/sbin/cz-light "$([ "$1" = 1 ] && echo on || echo off)" 2>&1
}
light_now=1

seen_on=0 off=0
while :; do
  if [ -e /run/czwallet/screen-off ]; then want=0; else want=1; fi
  if [ "$want" != "$light_now" ]; then light "$want"; light_now=$want; fi
  s=$(get 0xb9)
  if [ -n "$s" ]; then
    if [ $((s & 1)) = 1 ]; then seen_on=1; off=0
    elif [ $seen_on = 1 ]; then off=$((off + 1))
    fi
  fi
  if [ $off -ge 3 ]; then
    echo "power switch: off, shutting down"
    sync                                    # whatever happens next, the card is written
    # the chip has been counting since the switch moved (~1.2 s ago)
    deadline=$(( $(date +%s) + OFF_MS / 1000 - 1 ))
    systemctl stop czwallet czsigner 2>/dev/null
    # test cards (insert-coin-debug.txt): keep a record of the goodbye screen
    LOGP=""
    if [ -f /boot/firmware/insert-coin-debug.txt ]; then
      LOG=/boot/firmware/insert-coin-shutdown.txt
      echo "== $(date) switch off" >> $LOG
      LOGP="-p StandardOutput=append:$LOG -p StandardError=append:$LOG"
    fi
    # shellcheck disable=SC2086
    systemd-run --quiet --unit=czwallet-goodbye -p DefaultDependencies=no $LOGP \
      -p WorkingDirectory=/opt/czwallet /opt/czwallet-venv/bin/python -m ui.goodbye "$deadline" \
      2>>"${LOG:-/dev/null}" || echo "goodbye didn't start" >> "${LOG:-/dev/null}"
    sleep 1; sync
    exec systemctl poweroff
  fi
  sleep 0.5
done
