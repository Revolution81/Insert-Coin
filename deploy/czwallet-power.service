[Unit]
Description=Insert Coin: power helper (battery gauge, screen light, switch-off timing)
# See /usr/local/sbin/cz-power. Switching off itself is M5Stack's
# powerfail-suo driver's job.

[Service]
ExecStart=/usr/local/sbin/cz-power
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
