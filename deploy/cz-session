#!/bin/sh
# Root helper for app mode: run one Insert Coin session.
#
#  1. note whether networking is on and how bright the screen is
#  2. Vault mode (radios off), then start the wallet's services
#  3. wait until the wallet exits (SETUP > EXIT TO MENU)
#  4. stop every wallet service (the signer forgets the seed when it stops),
#     put Wi-Fi and the backlight back as they were
#
# Only one session at a time. Takes no arguments.
set -u
[ "$#" -eq 0 ] || { echo "usage: cz-session" >&2; exit 2; }
LOCK=/run/cz-session.lock
exec 9>"$LOCK"
flock -n 9 || { echo "Insert Coin is already running" >&2; exit 1; }

BL=/sys/class/backlight/backlight
net_was=$(nmcli -t networking 2>/dev/null || echo enabled)
bright=$(cat "$BL/brightness" 2>/dev/null || echo "")

stop_all() {
  systemctl stop czwallet czshare czprint czscan cznet czsigner tor 2>/dev/null
  if [ "$net_was" = "enabled" ]; then /usr/local/sbin/cz-radio online; fi
  if [ -n "$bright" ] && [ "$bright" != "0" ]; then echo "$bright" > "$BL/brightness" 2>/dev/null; fi
}
trap stop_all EXIT
trap 'exit 130' INT TERM HUP

# the wallet's screen needs the light on (the launcher may have dimmed it)
if [ "$(cat "$BL/brightness" 2>/dev/null || echo 1)" = "0" ]; then
  cat "$BL/max_brightness" > "$BL/brightness" 2>/dev/null
fi

systemctl start czwallet-vault                 # every session starts in Vault mode
systemctl start tor czsigner cznet czscan czprint czwallet || exit 1
sleep 2
while systemctl is-active -q czwallet; do
  sleep 1
done
exit 0
