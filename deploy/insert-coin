#!/bin/sh
# Insert Coin, started from M5Stack's launcher (app mode).
#
# The launcher runs this as its own user and waits for it to finish. The
# wallet itself runs in its own locked-down services (cz-session, as root
# through one sudo rule); this script only frees the speaker from the
# desktop's PipeWire for the time being and puts it back afterwards.
units="pipewire-pulse.socket pipewire-pulse.service pipewire.socket pipewire.service wireplumber.service"
# The launcher (a root service) drops to its user without a session
# environment; point systemctl --user at that user's manager.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
user_ctl() {
  if [ "$(id -u)" = 0 ]; then                  # launcher kept root: the UID 1000 desktop
    u="$(getent passwd 1000 | cut -d: -f1)"
    [ -n "$u" ] && runuser -u "$u" -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user "$@"
  else
    systemctl --user "$@"
  fi
}
user_ctl stop $units 2>/dev/null
if [ "$(id -u)" = 0 ]; then /usr/local/sbin/cz-session; else sudo -n /usr/local/sbin/cz-session; fi
rc=$?
user_ctl start pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null
exit $rc
