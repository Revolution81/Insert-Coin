[Unit]
Description=Insert Coin: the SHUTTING DOWN screen when the device powers off
# Nothing to do at boot. On the way down (power switch, POWER OFF, anything)
# this stops right after the signer has (stop order is the reverse of
# start order), so Sir Signer's SHUTTING DOWN screen goes up then. M5Stack's
# own power-switch driver (powerfail-suo) starts the shutdown itself, so the
# screen can't wait for our switch watcher. ALL DONE comes from the last
# shutdown hook, /usr/lib/systemd/system-shutdown/czwallet-done.
Before=czsigner.service czwallet.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
WorkingDirectory=/opt/czwallet
ExecStop=/bin/sh -c 'L=/dev/null; [ -f /boot/firmware/insert-coin-debug.txt ] && L=/boot/firmware/insert-coin-shutdown.txt; echo "== $$(date) shutting down" >> $$L; /usr/local/sbin/cz-light on >> $$L 2>&1; /opt/czwallet-venv/bin/python -m ui.goodbye --shutting >> $$L 2>&1; sync'
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
